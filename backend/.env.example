# Server
PORT=5001
NODE_ENV=development

# MongoDB (local or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/voxa

# Auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Groq (free tier — used for coaching tips AND Whisper transcription)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Razorpay (subscription) — fill before enabling billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Front-end origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Admin allowlist (comma-separated) — these accounts skip the freemium gate.
# Useful for testing + your own founder accounts.
ADMIN_EMAILS=
