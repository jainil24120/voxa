# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/voxa

# Auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Groq (free tier — for coaching text)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Razorpay (subscription)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Whisper (path to local whisper.cpp binary or python whisper command)
WHISPER_BIN=whisper
WHISPER_MODEL=base.en
